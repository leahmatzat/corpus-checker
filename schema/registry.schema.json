{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/corpus-checker/schema/registry.schema.json",
  "title": "corpus-checker registry entry",
  "description": "One model. Every claim carries a source. Cross-field rules that cannot be expressed here are enforced by the validator.",
  "type": "object",
  "required": ["model", "paper", "manifest", "evaluation_datasets", "result", "provenance"],
  "additionalProperties": false,

  "properties": {
    "model":   { "type": "string", "minLength": 1 },
    "version": { "type": "string", "description": "Which checkpoint/variant was scored. Models ship variants; the entry must say which one." },

    "paper": {
      "type": "object",
      "description": "The PUBLISHED version when one exists. Preprint-vs-published drift is real: Geneformer's corpus, parameter count, input window and vocabulary all differ.",
      "anyOf": [ { "required": ["doi"] }, { "required": ["pmid"] } ],
      "additionalProperties": false,
      "properties": {
        "doi":       { "type": "string", "pattern": "^10\\.\\d{4,}/\\S+$" },
        "pmid":      { "type": ["string", "integer"] },
        "journal":   { "type": "string" },
        "published": { "type": "string", "pattern": "^\\d{4}(-\\d{2}){0,2}$" },
        "preprint":  { "type": "string", "description": "DOI or URL of the preprint, when the entry was scored against the published version." },
        "note":      { "type": "string" }
      }
    },

    "manifest": {
      "type": "object",
      "required": ["type", "quote", "as_of"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["A", "A+", "B", "C-named", "C-vague", "D"],
          "description": "A static list | A+ corpus published | B versioned pointer | C-named prose but resolvable | C-vague/D not checkable"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "description": "VERBATIM data-availability statement. Required for every type INCLUDING C-vague and D -- for those it is the entire evidence for the NOT CHECKABLE verdict."
        },
        "as_of":    { "type": "string", "format": "date" },
        "identifier_type": {
          "enum": ["accession", "citation", "mixed"],
          "description": "SECOND AXIS, independent of type. A published list can be keyed by accession (scFoundation) or by CITATION STRING (Geneformer -- 561 rows, zero accessions). Citation-keyed lists are complete and closed but need citation->PMID resolution before any exact match is possible."
        },
        "resolver": { "type": "string", "description": "Which resolvers/ implementation handles this manifest." },
        "sources":  { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/manifestSource" } },
        "pointer":  { "$ref": "#/$defs/manifestPointer" },
        "corpus_published": { "$ref": "#/$defs/corpusPublished" },
        "totals": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "gaps": {
          "type": "object",
          "description": "Why single-key matching is unsafe for this manifest. Free-form counts.",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },

      "allOf": [
        {
          "if":   { "properties": { "type": { "enum": ["A", "A+"] } }, "required": ["type"] },
          "then": { "required": ["sources", "resolver"] }
        },
        {
          "if":   { "properties": { "type": { "const": "B" } }, "required": ["type"] },
          "then": { "required": ["pointer", "resolver"] }
        },
        {
          "if":   { "properties": { "type": { "enum": ["C-vague", "D"] } }, "required": ["type"] },
          "then": { "not": { "anyOf": [ { "required": ["sources"] }, { "required": ["pointer"] } ] } }
        }
      ]
    },

    "evaluation_datasets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evalDataset" }
    },

    "result": {
      "type": "object",
      "required": ["checked", "sources_searched", "match_keys", "findings"],
      "additionalProperties": false,
      "properties": {
        "checked": { "type": "string", "format": "date" },
        "sources_searched": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Empty is only legal when the manifest type is C-vague or D."
        },
        "match_keys": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["accession", "pmid", "doi", "title", "keyword"] },
          "description": "Match on BOTH accession and pmid where available. scFoundation had 161/522 blank PMIDs and 134/656 projects with no title or PMID."
        },
        "findings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/finding" } },
        "caveats":  { "type": "array", "items": { "type": "string" } }
      }
    },

    "provenance": {
      "type": "object",
      "required": ["verified_by", "verified_date", "method"],
      "additionalProperties": false,
      "properties": {
        "verified_by":   { "type": "string", "description": "A PERSON. Empty string = drafted, not yet verified. The FIELD is required here; the NON-EMPTY check lives in CI so that a draft entry can be committed but not merged. CI also clears it whenever result: changes." },
        "verified_date": { "type": ["string", "null"], "format": "date" },
        "method":        { "type": "string", "description": "Path to the script or resolver that produced this." },
        "reproducible":  { "type": "boolean" }
      }
    },

    "disputed": { "$ref": "#/$defs/dispute" }
  },

  "allOf": [
    {
      "$comment": "THE SUPERSET RULE. A Type-B manifest names a corpus the model trained on a SUBSET of. Absence is provable; presence is not.",
      "if":   { "properties": { "manifest": { "properties": { "type": { "const": "B" } }, "required": ["type"] } }, "required": ["manifest"] },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "findings": { "items": { "properties": { "verdict": { "not": { "const": "PRESENT" } } } } }
            }
          }
        }
      }
    },
    {
      "$comment": "No manifest means no verdict other than NOT CHECKABLE.",
      "if":   { "properties": { "manifest": { "properties": { "type": { "enum": ["C-vague", "D"] } }, "required": ["type"] } }, "required": ["manifest"] },
      "then": {
        "properties": {
          "result": {
            "properties": {
              "findings": { "items": { "properties": { "verdict": { "const": "NOT CHECKABLE" } } } }
            }
          }
        }
      }
    },
    {
      "$comment": "sources_searched may only be empty when there was nothing to search.",
      "if":   { "properties": { "manifest": { "properties": { "type": { "enum": ["A", "A+", "B", "C-named"] } }, "required": ["type"] } }, "required": ["manifest"] },
      "then": { "properties": { "result": { "properties": { "sources_searched": { "minItems": 1 } } } } }
    }
  ],

  "$defs": {

    "manifestSource": {
      "type": "object",
      "required": ["name", "url", "format", "sha256"],
      "additionalProperties": false,
      "properties": {
        "name":    { "type": "string" },
        "url":     { "type": "string", "format": "uri" },
        "format":  { "enum": ["xlsx", "csv", "tsv", "json", "txt", "pdf", "parquet", "h5ad"] },
        "level":   { "enum": ["sample", "study", "project", "cell", "dataset"] },
        "records": { "type": "integer", "minimum": 0 },
        "bytes":   { "type": "integer", "minimum": 0 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "as_of says WHEN we looked. sha256 says WHAT we looked at. A URL can serve different bytes later without telling you."
        },
        "columns": { "type": "array", "items": { "type": "string" } },
        "note":    { "type": "string", "description": "Flag anything about this source that is not yet confirmed -- e.g. a URL pattern inferred rather than followed." }
      }
    },

    "manifestPointer": {
      "type": "object",
      "description": "Type B. The corpus is external, versioned and larger than what the model used.",
      "required": ["corpus", "release"],
      "additionalProperties": false,
      "properties": {
        "corpus":       { "type": "string", "examples": ["CELLxGENE census"] },
        "release":      { "type": "string", "examples": ["2023-05-15"] },
        "url":          { "type": "string", "format": "uri" },
        "superset_size":{ "type": "string", "description": "Size of the pointed-to corpus." },
        "model_used":   { "type": "string", "description": "What the model actually trained on, if stated. scGPT: ~33M of 57.9M." }
      }
    },

    "corpusPublished": {
      "type": "object",
      "description": "The corpus itself is downloadable. INDEPENDENT of whether a manifest exists -- Geneformer publishes the corpus and no manifest. Present on any type.",
      "required": ["url", "carries_provenance"],
      "additionalProperties": false,
      "properties": {
        "url":     { "type": "string", "format": "uri" },
        "commit":  { "type": "string" },
        "license": { "type": "string" },
        "bytes":   { "type": "integer", "minimum": 0 },
        "fields":  { "type": "array", "items": { "type": "string" }, "description": "The corpus schema. This is what decides carries_provenance." },
        "carries_provenance": {
          "type": "boolean",
          "description": "Does a row say which source dataset it came from? FALSE means downloading the whole corpus answers nothing, and the entry is NOT CHECKABLE however many bytes are public."
        }
      }
    },

    "evalDataset": {
      "type": "object",
      "required": ["name", "task"],
      "anyOf": [ { "required": ["accession"] }, { "required": ["pmid"] }, { "required": ["doi"] } ],
      "additionalProperties": false,
      "properties": {
        "name":      { "type": "string" },
        "accession": { "type": "string", "pattern": "^(GSE\\d+|GSM\\d+|E-MTAB-\\d+|SRP\\d+|PRJNA\\d+|SCP\\d+)$" },
        "doi":       { "type": "string", "pattern": "^10\\.\\d{4,}/\\S+$" },
        "pmid":      { "type": ["string", "integer"] },
        "task":      { "type": "string", "description": "A model can be clean on one task and contaminated on another." },
        "obtained_from": { "type": "string", "description": "Where the AUTHORS got it. 'GEARS repo' is the common answer and is itself a finding." },
        "note":      { "type": "string", "description": "Use this to flag an identifier that has NOT been resolved through the crosswalk." }
      }
    },

    "finding": {
      "type": "object",
      "required": ["dataset", "verdict"],
      "additionalProperties": false,
      "properties": {
        "dataset": { "type": "string", "description": "Must match an evaluation_datasets[].name." },
        "verdict": { "enum": ["PRESENT", "NOT PRESENT", "INCONCLUSIVE", "NOT CHECKABLE"] },
        "matched_on": { "type": "array", "items": { "enum": ["accession", "pmid", "doi", "title", "keyword"] } },
        "samples":    { "type": "integer", "minimum": 0 },
        "sample_ids": { "type": "array", "items": { "type": "string" } },
        "cells":      { "type": "integer", "minimum": 0 },
        "reason":     { "type": "string", "description": "REQUIRED for INCONCLUSIVE. Say why the match is weak." },
        "note":       { "type": "string" }
      },
      "allOf": [
        {
          "$comment": "A PRESENT verdict must carry the evidence that produced it.",
          "if":   { "properties": { "verdict": { "const": "PRESENT" } }, "required": ["verdict"] },
          "then": { "required": ["matched_on"], "anyOf": [ { "required": ["sample_ids"] }, { "required": ["samples"] }, { "required": ["cells"] } ] }
        },
        {
          "if":   { "properties": { "verdict": { "const": "INCONCLUSIVE" } }, "required": ["verdict"] },
          "then": { "required": ["reason"] }
        }
      ]
    },

    "dispute": {
      "type": "object",
      "description": "An entry is never silently deleted. A contested entry stays visible with the dispute attached.",
      "required": ["raised_by", "date", "statement"],
      "additionalProperties": false,
      "properties": {
        "raised_by": { "type": "string" },
        "date":      { "type": "string", "format": "date" },
        "statement": { "type": "string" },
        "response":  { "type": "string" },
        "resolved":  { "type": "boolean" }
      }
    }
  }
}
